{
  "dockerfile_lines": [
    "FROM python:3.12-slim"
  ],
  "dependencies": [
    "./backend/blog_agent",
    "./backend/chat_agent",
    "./backend/dashboard_agent",
    "./backend/data_agent",
    "./backend/data_research_agent",
    "./backend/news_agent",
    "./backend/research_agent",
    "./backend/slide_agent",
    "./backend/slide_build_agent",
    "./backend/task_agent",
    "./backend/ui_agent",
    "./backend/ui_build_agent",
    "./backend/ui_eval_agent",
    "./backend/libs/thothy"
  ],
  "graphs": {
    "blog_graph": "./backend/blog_agent/src/blog_graph/graph.py:graph",
    "chat_graph": "./backend/chat_agent/src/chat_graph/graph.py:graph",
    "dashboard_graph": "./backend/dashboard_agent/src/dashboard_graph/graph.py:graph",
    "data_graph": "./backend/data_agent/src/data_graph/graph.py:graph",
    "data_research_graph": "./backend/data_research_agent/src/data_research_graph/graph.py:graph",
    "news_graph": "./backend/news_agent/src/news_graph/graph.py:graph",
    "research_graph": "./backend/research_agent/src/research_graph/graph.py:graph",
    "slide_graph": "./backend/slide_agent/src/slide_graph/graph.py:graph",
    "slide_build_graph": "./backend/slide_build_agent/src/slide_build_graph/graph.py:graph",
    "task_graph": "./backend/task_agent/src/task_graph/graph.py:graph",
    "ui_graph": "./backend/ui_agent/src/ui_graph/graph.py:graph",
    "ui_build_graph": "./backend/ui_build_agent/src/ui_build_graph/graph.py:graph",
    "ui_eval_graph": "./backend/ui_eval_agent/src/ui_eval_graph/graph.py:graph"
  },
  "auth": {
    "path": "./backend/security/auth.py:auth",
    "disable_studio_auth": false
  },
  "env": ".env",
  "python_version": "3.12"
}